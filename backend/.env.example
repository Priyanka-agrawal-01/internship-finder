# InternPulse Backend Configuration
# Copy this file to .env and fill in what you need. Never commit .env.

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS. Separate several with commas, e.g.
# FRONTEND_URL=https://your-app.vercel.app,https://www.your-domain.com
# The first one is also used for links in emails.
FRONTEND_URL=http://localhost:5173

# Public URL of this backend, used for unsubscribe links in emails.
# On Render this falls back to RENDER_EXTERNAL_URL automatically.
BACKEND_URL=http://localhost:5000

# Enables the admin endpoints (POST /api/jobs/refresh, GET /api/subscribe/status).
# Send it in the x-admin-token header. Leave blank to disable them.
ADMIN_TOKEN=

# ── MongoDB (optional) ──────────────────────────────────────
# Without it, subscriptions live in memory and job alerts are disabled.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/internpulse
MONGODB_URI=

# ── Email (optional) ────────────────────────────────────────
# Leave all of these blank to use a throwaway Ethereal test inbox
# (preview links are printed in the server log).
#
# Generic SMTP:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="InternPulse Alerts" <alerts@example.com>
#
# Or Gmail shorthand (use a 16-character App Password, not your real password):
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# ── Job alert schedule (optional) ───────────────────────────
# Cron for the alert cycle. Default is hourly; each subscriber's chosen
# frequency (hourly / every 6 hours / daily) is still respected.
# ALERT_CRON=0 * * * *

# ── Job APIs (optional — Remotive, Arbeitnow and The Muse need no key) ──
# https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# MUSE_API_KEY=
